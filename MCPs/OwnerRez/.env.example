# OwnerRez API — https://www.ownerrez.com/support/articles/api-auth
# Create token: OwnerRez → Settings → Advanced Tools → Developer/API Settings (token starts pt_)
OWNERREZ_EMAIL=      # REQUIRED — your OwnerRez login email
OWNERREZ_TOKEN=      # REQUIRED — the pt_ token

# --- Optional: OAuth-app token (enables messaging, which PATs can't do). If set, used instead of
#     the PAT above. Create an OAuth app + "Grant Access To Me": ownerrez.com/support/articles/api-oauth-app
OWNERREZ_OAUTH_TOKEN=   # the at_ token
OWNERREZ_APP_UA=        # User-Agent, e.g. "My App/1.0 (c_12345)" — required by OwnerRez for OAuth

# --- Remote/HTTP server only (npm run start:http). Not needed for local stdio use. ---
MCP_AUTH_TOKEN=      # bearer token clients must send; generate a long random string before deploying
PORT=8080            # optional; host platforms usually set this automatically
